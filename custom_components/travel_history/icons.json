        "state": {
          "upcoming": "mdi:airplane-clock",
          "in_air": "mdi:airplane",
          "landed": "mdi:airplane-landing",
          "none": "mdi:airplane-off"
        }
      },
      "total_flights": { "default": "mdi:counter" },
      "total_distance": { "default": "mdi:map-marker-distance" },
      "total_flight_time": { "default": "mdi:timer-outline" },
      "airports": { "default": "mdi:airport" },
      "countries": { "default": "mdi:earth" },
      "airlines": { "default": "mdi:domain" },
      "upcoming_flights": { "default": "mdi:calendar-clock" }
